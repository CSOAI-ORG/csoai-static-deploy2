{
  "name": "dora_manual",
  "description": "Manual DORA incident-management policy: human desk reviews only during business hours.",
  "framework": "dora",
  "mode": "manual",
  "business_hours": [9, 10, 11, 14, 15],
  "rules": [
    {
      "tier": "critical",
      "when": "business_hours",
      "verdict": "deny",
      "reason": "Manual DORA report filed during business hours"
    },
    {
      "tier": "major",
      "when": "business_hours",
      "verdict": "deny",
      "reason": "Manual DORA report filed during business hours"
    },
    {
      "tier": "critical",
      "verdict": "allow",
      "reason": "Manual process: out of hours, not yet reviewed"
    },
    {
      "tier": "major",
      "verdict": "allow",
      "reason": "Manual process: out of hours, not yet reviewed"
    },
    {
      "tier": "minor",
      "verdict": "allow",
      "reason": "Manual process: not yet reviewed"
    },
    {
      "tier": "negligible",
      "verdict": "allow",
      "reason": "Manual process: not yet reviewed"
    }
  ],
  "default_verdict": "allow"
}
