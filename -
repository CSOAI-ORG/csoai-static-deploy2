      element: '#pricing',
      position: 'top'
    }
  ],
  
  currentStep: 0,
  isActive: false,
  
  async start() {
    this.isActive = true;
    this.currentStep = 0;
    this.showOverlay();
    await this.runStep();
  },
  
  async runStep() {
    if (!this.isActive || this.currentStep >= this.steps.length) {
      this.end();
      return;
    }
    
    const step = this.steps[this.currentStep];
    
    // Speak (browser TTS)
    this.speak(step.text);
    
    // Show text bubble
    this.showBubble(step.text, step.element, step.position);
    
    // Highlight element
    if (step.element) {
      this.highlight(step.element);
    }
    
    // Wait for click or 8 seconds
    await this.waitForNext();
    this.currentStep++;
    this.runStep();
  },
  
  speak(text) {
    if ('speechSynthesis' in window) {
      const utter = new SpeechSynthesisUtterance(text);
      utter.rate = 0.9;
      utter.pitch = 0.8; // Deep, authoritative voice
      window.speechSynthesis.speak(utter);
    }
  },
  
  showBubble(text, target, position) {
    // Remove old bubble
    const old = document.querySelector('.sov-tour-bubble');
    if (old) old.remove();
    
    const bubble = document.createElement('div');
    bubble.className = 'sov-tour-bubble';
    bubble.innerHTML = `
      <div style="background: rgba(0,0,0,0.9); color: #FFD700; padding: 20px; border-radius: 12px; max-width: 400px; border: 2px solid #FFD700; font-family: monospace; box-shadow: 0 0 30px rgba(255,215,0,0.3);">
        <div style="font-size: 24px; margin-bottom: 10px;">🐉</div>
        <div style="font-size: 16px; line-height: 1.5;">${text}</div>
        <div style="margin-top: 15px; text-align: right;">
          <button onclick="SOVTour.next()" style="background: #FFD700; color: black; border: none; padding: 8px 16px; cursor: pointer; font-weight: bold;">NEXT →</button>
        </div>
      </div>
    `;
    
    document.body.appendChild(bubble);
    
    // Position near target
    if (target) {
      const el = document.querySelector(target);
      if (el) {
        const rect = el.getBoundingClientRect();
        bubble.style.position = 'fixed';
        bubble.style.zIndex = '99999';
        
        if (position === 'right') {
          bubble.style.left = (rect.right + 20) + 'px';
          bubble.style.top = rect.top + 'px';
        } else if (position === 'bottom') {
          bubble.style.left = rect.left + 'px';
          bubble.style.top = (rect.bottom + 20) + 'px';
        } else if (position === 'top') {
          bubble.style.left = rect.left + 'px';
          bubble.style.bottom = (window.innerHeight - rect.top + 20) + 'px';
        } else {
          bubble.style.left = '50%';
          bubble.style.top = '50%';
          bubble.style.transform = 'translate(-50%, -50%)';
        }
      }
    } else {
      bubble.style.position = 'fixed';
      bubble.style.left = '50%';
      bubble.style.top = '50%';
      bubble.style.transform = 'translate(-50%, -50%)';
      bubble.style.zIndex = '99999';
    }
  },
  
  highlight(selector) {
    // Remove old highlights
    document.querySelectorAll('.sov-highlight').forEach(el => el.classList.remove('sov-highlight'));
    
    const el = document.querySelector(selector);
    if (el) {
      el.classList.add('sov-highlight');
      el.style.boxShadow = '0 0 0 4px #FFD700, 0 0 30px rgba(255,215,0,0.5)';
      el.style.transition = 'box-shadow 0.3s';
    }
  },
  
  waitForNext() {
    return new Promise(resolve => {
      this._resolve = resolve;
      setTimeout(() => {
        if (this._resolve) {
          this._resolve();
          this._resolve = null;
        }
      }, 8000); // Auto-advance after 8 seconds
    });
  },
  
  next() {
    if (this._resolve) {
      this._resolve();
      this._resolve = null;
    }
  },
  
  end() {
    this.isActive = false;
    const bubble = document.querySelector('.sov-tour-bubble');
    if (bubble) bubble.remove();
    document.querySelectorAll('.sov-highlight').forEach(el => {
      el.style.boxShadow = '';
      el.classList.remove('sov-highlight');
    });
    window.speechSynthesis.cancel();
  },
  
  showOverlay() {
    // Darken rest of page
    const overlay = document.createElement('div');
    overlay.id = 'sov-tour-overlay';
    overlay.style.cssText = 'position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 99998; pointer-events: none;';
    document.body.appendChild(overlay);
  }
};

