// sov-os/src/adapters/graft.rs
// Graft codebase graph → SOVOS Honey

pub struct GraftAdapter {
    pub graft_path: PathBuf,
    pub honey_tx: mpsc::Sender<HoneyRecord>,
}

impl GraftAdapter {
    pub fn watch_graft(&self) {
        // Graft generates graph on every file change
        // We convert that graph to Phlabet glyphs
        
        let graph = self.read_graft_graph();
        
        for node in graph.nodes {
            // Code symbol → Phlabet glyph
            let glyph = Phlabet::from_code_symbol(
                &node.name,
                &node.node_type,  // function, struct, trait, etc.
                &node.dependencies,
            );
            
            // Store in IWM under "code knowledge" shard
            let record = HoneyRecord {
                epoch: current_epoch(),
                scale: 4, // code module level
                clan: ClanId::SOVOS, // your codebase
                glyph,
                provenance: Provenance::Graft,
            };
            
            self.honey_tx.send(record).unwrap();
        }
    }
}

