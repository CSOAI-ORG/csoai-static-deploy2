# sov-academy/src/living_cert.py
# A certification is NOT a PDF. It is a LIVE CONTRACT with the blockchain.

class LivingCertification:
    def __init__(self, holder_id, role, standard):
        self.holder = holder_id          # Who owns this cert
        self.role = role                 # CISO / Regulator / Public / AI Dev
        self.standard = standard         # EU AI Act / NIST RMF / TC260 / SOV Core
        self.epoch = current_epoch()     # When issued
        self.gspc = [0.0, 0.0, 0.0, 0.0]  # Live scores
        self.status = "ACTIVE"           # ACTIVE / EXPIRED / REVOKED / UPDATED
        self.merkle_root = None          # Blockchain anchor
        
    def check_liveness(self):
        """
        Called every day by SOVOS cron.
        If the underlying regulation changed, cert status = 'NEEDS_UPDATE'
        """
        current_reg_version = RegulationAPI.get_version(self.standard)
        
        if current_reg_version > self.epoch:
            # The law changed since this cert was issued
            self.status = "NEEDS_UPDATE"
            
            # Auto-generate a "delta quest" — what changed?
            delta = RegulationAPI.get_delta(self.epoch, current_reg_version)
            
            # Notify user via SOV SPACE
            SOV_SPACE.notify(
                user=self.holder,
                message=f"⚠️ {self.standard} updated. Complete 'Delta Quest: {delta.title}' to keep cert active.",
                urgency="HIGH"
            )
            
            # Auto-enroll in refresher
            QuestEngine.enroll(self.holder, delta.to_quest())
            
        return self.status
    
    def complete_quest(self, quest):
        """
        User finished the delta training.
        Update cert. New epoch. New merkle root.
        """
        self.epoch = current_epoch()
        self.gspc = GSPC.score_quest_completion(quest)
        self.merkle_root = Blockchain.anchor(self)
        self.status = "ACTIVE"
        
        # Generate Honey: "User X learned new regulation Y"
        Honey.record_cert_update(self)
        
        return self

