// sov-os/src/adapters/mod.rs
// The SOV OS Core — ~500 lines total

use std::sync::Arc;
use tokio::sync::mpsc;

pub struct SovNode {
    pub id: u64,           // 8 bytes
    pub clan: ClanId,      // 4 bytes  
    pub kind: NodeKind,    // 1 byte
    pub state: Vec<u8>,    // compressed binary, typically <1KB
    pub connections: Vec<u64>, // wire to other nodes
}

pub enum NodeKind {
    ModelRouter,      // Routes to cheapest/fastest model
    AgentHarness,     // Wraps Claude/Codex/OpenCode/Hermes
    McpServer,        // Native MCP, no JSON overhead
    ToolExecutor,     // Direct function call
    MemoryShard,      // Compressed context window
    VisualEntity,     // 3D node in SOV SPACE
}

// The harness loop — 0 allocation hotpath
pub async fn harness_loop(mut node: SovNode) {
    let mut buf = [0u8; 4096]; // stack buffer, no heap
    loop {
        let msg = node.recv_binary(&mut buf).await;
        match msg.opcode {
            0x01 => route_to_model(msg),      // direct API call
            0x02 => spawn_subagent(msg),       // fork node
            0x03 => mcp_tool_call(msg),        // native MCP
            0x04 => merge_memory(msg),        // compress context
            0x05 => visual_update(msg),       // SOV SPACE render
            _ => drop(msg),                    // unknown = ignore
        }
    }
}

Why Rust/Zig instead of Holy C? Because we need memory safety for agent swarms, but we compile with opt-level=3, lto=true, codegen-units=1 — single binary, no dynamic linking, no runtime. The resulting binary is <2MB.

