{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.CSOAI-ORG/csoai",
  "description": "Signed deterministic AI-governance measurement: EU AI Act cards + agent-callable record verify.",
  "version": "0.1.2",
  "repository": {
    "url": "https://github.com/CSOAI-ORG/councilof-ai",
    "source": "github"
  },
  "websiteUrl": "https://councilof.ai",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "csoai",
      "version": "0.1.2",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "csoai[mcp]",
          "description": "install with the MCP extra (fastmcp)"
        },
        {
          "type": "positional",
          "value": "csoai-mcp",
          "description": "the MCP server entry point"
        }
      ]
    }
  ]
}