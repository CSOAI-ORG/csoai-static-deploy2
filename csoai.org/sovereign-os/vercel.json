{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "frontend/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "dist/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "api/brain.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/dist/index.html"
    },
    {
      "src": "/sovereign-os/(.*)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/api/chat",
      "dest": "/api/brain.py"
    },
    {
      "src": "/api/status",
      "dest": "/api/brain.py"
    }
  ],
  "env": {
    "SOV3_CARE_FLOOR": "0.95",
    "SOV3_BFT_MAJORITY": "0.667",
    "SOV3_CROWN_LINEAGE": "1795-2026"
  }
}