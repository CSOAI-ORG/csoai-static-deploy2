{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Council of AI 3KB Unit \u2014 the atomic asset of the data-annuity engine",
  "type": "object",
  "required": [
    "id",
    "class",
    "axis",
    "body",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "content-hash (sha256, first 8 hex) of body"
    },
    "class": {
      "type": "string",
      "enum": [
        "REAL",
        "THEORY",
        "UNVERIFIED",
        "KILLED"
      ]
    },
    "axis": {
      "type": [
        "integer",
        "string"
      ],
      "description": "GSPC axis 1-15, or 'meta'"
    },
    "body": {
      "type": "string",
      "description": "the dense finding \u2014 tables over prose, figures carry as-of dates",
      "maxLength": 2800
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "citation metadata or 'K3-verified <method>'"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "hashes of upstream units this derives from (Merkle-style)"
    },
    "sig": {
      "type": "string",
      "description": "signature once published into the chain"
    }
  }
}