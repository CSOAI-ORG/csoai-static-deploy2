-- ============================================================================
-- PRESS BLITZ FULL — 1,076 contacts, ~10-15 minutes
-- Run with: osascript press_blitz.applescript
-- Creates drafts in Mail.app. You then click Send.
-- ============================================================================

property totalCreated : 0
property totalFailed : 0
property logFile : "/Users/nicholas/clawd/PASSPORT_LAUNCH_13JUN/press_send.log"

on logMsg(msg)
    set theFile to open for access logFile with write permission
    write ((current date) as string) & " | " & msg & return to theFile as string
    close access theFile
end logMsg

on createDraft(theEmail, theFirst, theOutlet, theBeat)
    try
        set theSubject to "Open source — the missing A2A primitive, 49 days before the EU cliff"
        set theBody to my buildBody(theFirst, theOutlet, theBeat)
        set newMessage to make new outgoing message with properties {subject:theSubject, content:theBody}
        tell newMessage
            make new to recipient at end of to recipients with properties {address:theEmail}
            set visible to false
        end tell
        set totalCreated to totalCreated + 1
        if (totalCreated mod 100) = 0 then
            logMsg ("OK  | " & totalCreated & " drafts created so far")
        end if
    on error errMsg
        set totalFailed to totalFailed + 1
        logMsg ("ERR | " & theEmail & " | " & errMsg)
    end try
end createDraft

on buildBody(theFirst, theOutlet, theBeat)
    set openerAI to "Since you cover the AI beat for " & theOutlet & ","
    set openerML to "Since you cover the ML beat for " & theOutlet & ","
    set openerEU to "Since you cover EU policy at " & theOutlet & ","
    set openerReg to "Since you cover regulation at " & theOutlet & ","
    set openerSec to "Since you cover security at " & theOutlet & ","
    set openerFin to "Since you cover fintech at " & theOutlet & ","
    set openerDev to "Since you cover dev tools at " & theOutlet & ","
    set openerOS to "Since you cover open source at " & theOutlet & ","
    set openerSU to "Since you cover startups at " & theOutlet & ","
    set openerGen to "As a writer I admire at " & theOutlet & ","

    if theBeat contains "ai" then
        set theOpener to openerAI
    else if theBeat contains "ml" then
        set theOpener to openerML
    else if theBeat contains "eu" then
        set theOpener to openerEU
    else if theBeat contains "reg" then
        set theOpener to openerReg
    else if theBeat contains "sec" then
        set theOpener to openerSec
    else if theBeat contains "fin" then
        set theOpener to openerFin
    else if theBeat contains "dev" then
        set theOpener to openerDev
    else if theBeat contains "open" then
        set theOpener to openerOS
    else if theBeat contains "start" then
        set theOpener to openerSU
    else
        set theOpener to openerGen
    end if

    set theBody to "Hi " & theFirst & "," & return & return & theOpener & " I wanted to flag a launch that lands directly in your wheelhouse." & return & return
    set theBody to theBody & "EU AI Act Article 50 kicks in on 2 Aug 2026 — 49 days from today." & return & return
    set theBody to theBody & "For every new generative AI system shipped into the EU, three requirements become law:" & return
    set theBody to theBody & "1. Mark all AI-generated content (C2PA + watermark)" & return
    set theBody to theBody & "2. Disclose AI involvement" & return
    set theBody to theBody & "3. Remain human-oversightable" & return & return
    set theBody to theBody & "The unanswered question is: how does Agent B on the other side of a transaction KNOW that Agent A meets that bar?" & return & return
    set theBody to theBody & "Today we are shipping the missing primitive: the Agent Compliance Passport." & return & return
    set theBody to theBody & "It is an open-source MCP server (3 tools, 14 tests, 7 files, 28KB of code) that:" & return
    set theBody to theBody & "- Issues Ed25519-signed passports to AI agents" & return
    set theBody to theBody & "- Verifies them offline (100% offline, no API call)" & return
    set theBody to theBody & "- Does the A2A handshake between two agents" & return & return
    set theBody to theBody & "A passport carries the agent identity, a list of 11 compliance frameworks (EU AI Act, Article 50, GDPR, HIPAA, SOC 2, ISO 42001, NIST AI RMF, CRA, DORA, NIS2), and per-claim status — all signed with Ed25519." & return & return
    set theBody to theBody & "Three things you can do:" & return
    set theBody to theBody & "1. Try it: pip install meok-compliance-passport-mcp" & return
    set theBody to theBody & "2. Cover the story: 30-min interview slot, press kit, demo video" & return
    set theBody to theBody & "3. Quote us: press@meok.ai for embargoed coverage before 2 Aug 2026" & return & return
    set theBody to theBody & "GitHub: https://github.com/CSOAI-ORG/meok-compliance-passport-mcp" & return & return
    set theBody to theBody & "Best," & return
    set theBody to theBody & "Nick Templeman" & return
    set theBody to theBody & "Founder, MEOK AI Labs" & return
    set theBody to theBody & "press@meok.ai · https://meok.ai" & return
    return theBody
end buildBody

