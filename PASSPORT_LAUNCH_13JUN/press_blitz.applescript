    logMsg ("Loaded " & (count of theContacts) & " contacts")
    set totalContacts to count of theContacts
    set batchSize to 50
    set batchNum to 0

    repeat with aContact in theContacts
        if (class of aContact) is string then exit repeat
        set {theEmail, theFirst, theOutlet, theBeat} to aContact
        my createDraft(theEmail, theFirst, theOutlet, theBeat)
        if (totalCreated mod batchSize) = 0 and totalCreated > 0 then
            set batchNum to batchNum + 1
            logMsg ("=== Batch " & batchNum & " complete. Total: " & totalCreated & " / Failed: " & totalFailed & " ===")
            delay 2
        end if
    end repeat

    logMsg ("=== PRESS BLITZ FULL COMPLETE: created=" & totalCreated & " failed=" & totalFailed & " ===")
    display dialog ("Press Blitz complete!" & return & return & "Created: " & totalCreated & return & "Failed: " & totalFailed & return & return & "Next: open Mail.app Drafts, review, then send.") buttons {"OK"} default button "OK"
end run