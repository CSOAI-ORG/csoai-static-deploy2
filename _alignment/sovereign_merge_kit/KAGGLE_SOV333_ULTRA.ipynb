  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["# 🐉 SOV333 ULTRA — Kaggle T4 Training Notebook\n\nThis is the **production notebook** for training SOV333 ultra on Kaggle T4.\n\n- **Free 30 hr/wk** with K4g/T4×2 accelerator\n- ~2-4hr to fully train SOV333 ultra (rank=32, 5000 examples, 1 epoch)\n- Loss target: 0.5-0.8 (vs 1.87 on MacBook)\n\n**Click Run All. Save outputs to /kaggle/working."]  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# STEP 1: Verify GPU\n",
    "import torch\n",
    "print('CUDA:', torch.cuda.is_available())\n",
    "print('GPU:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'no gpu')\n",
    "print('VRAM:', torch.cuda.get_device_properties(0).total_memory / 1e9, 'GB' if torch.cuda.is_available() else '')\n",
    "assert torch.cuda.is_available(), 'Enable GPU: Settings → Accelerator → GPU T4 ×2'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# STEP 2: Install\n",
    "!pip install -q transformers peft accelerate datasets"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# STEP 3: Pull the sovereign corpus from sovereign.wiki OR paste inline\n",
    "import json\n",
    "import urllib.request\n",
    "\n",
    "# Try to pull from sovereign.wiki\n",
    "try:\n",
    "    with urllib.request.urlopen('http://localhost:3101/api/owem/corpus', timeout=5) as r:\n",
    "        corpus = json.load(r)\n",
    "    print(f'Pulled {len(corpus)} examples from sovereign.wiki')\n",
    "except Exception as e:\n",
    "    print(f'No live corpus: {e}')\n",
    "    # Use our bundled 100 examples\n",
    "    corpus = None\n",
    "\n",
    "# If no corpus, generate synthetic sovereign examples\n",
    "if not corpus:\n",
    "    print('Generating synthetic sovereign corpus...')\n",
    "    corpus = []\n",
    "    domains = ['compliance', 'defense', 'intuition', 'voice', 'general']\n",
    "    patterns = [\n",
    "        'The care-floor is 0.95 across all sovereign actions.',\n",
    "        'BFT-33 requires 23/33 quorum for sovereign votes.',\n",
    "        'DEFONEOS has 3 compartments: meok-defoneos, csoai-defoneos, dagon.',\n",
    "        'Article 50 requires transparency markers in EU AI Act.',\n",
    "        'Ed25519 signing uses 32-byte private keys with sovereign wallet.',\n",
    "        'The sovereign SIGIL chain hashes every cycle for auditability.',\n",
    "        'OWEM emergence L3 means federated sovereign outputs.',\n",
    "        'Liquid AI Antidoom reduces doom-looping in reasoning models.',\n",
    "        'Kaggle T4 GPU has 16GB VRAM and 8 TFLOPS FP32 performance.',\n",
    "        'SOVTOK has 8,192 vocabulary with 181 sovereign terms.'\n",
    "    ]\n",
    "    for i in range(5000):\n",
    "        domain = domains[i % 5]\n",
    "        pattern = patterns[i % len(patterns)]\n",
    "        corpus.append({\n",
    "            'messages': [\n",
    "                {'role': 'user', 'content': f'Tell me about {domain}: ' + pattern.split()[0]},\n",
    "                {'role': 'assistant', 'content': pattern}\n",
    "            ]\n",
    "        })\n",
    "    print(f'Generated {len(corpus)} synthetic examples')\n",
    "\n",
    "# Format for trainer\n",
    "def format_example(d):\n",
    "    msgs = d.get('messages', [])\n",
    "    text = '\\n'.join(f\"<{m['role']}>: {m.get('content','')}\" for m in msgs if m.get('content'))\n",
    "    return {'text': text}\n",
    "\n",
    "formatted = [format_example(c) for c in corpus]\n",
    "formatted = [f for f in formatted if f['text']]\n",
    "print(f'Final corpus: {len(formatted)}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# STEP 4: Load model + LoRA\n",
    "from transformers import AutoModelForCausalLM, AutoTokenizer, TrainingArguments, Trainer, DataCollatorForLanguageModeling\n",
    "from datasets import Dataset\n",
    "from peft import LoraConfig, get_peft_model, TaskType\n",
    "import time\n",
    "\n",
    "BASE = 'Qwen/Qwen3-0.6B'\n",
    "print('Loading tokenizer...')\n",
    "tokenizer = AutoTokenizer.from_pretrained(BASE, trust_remote_code=True)\n",
    "if tokenizer.pad_token is None:\n",
    "    tokenizer.pad_token = tokenizer.eos_token\n",
    "\n",
    "print('Loading model on CUDA...')\n",
    "model = AutoModelForCausalLM.from_pretrained(BASE, torch_dtype=torch.float16, trust_remote_code=True)\n",
    "model = model.to('cuda')\n",
    "\n",
    "print('Adding LoRA rank=32 (4x bigger than Mac)...')\n",
    "lora_config = LoraConfig(\n",
    "    r=32, lora_alpha=64,\n",
    "    target_modules=['q_proj','k_proj','v_proj','o_proj'],\n",
    "    lora_dropout=0.05, bias='none',\n",
    "    task_type=TaskType.CAUSAL_LM,\n",
    ")\n",
    "model = get_peft_model(model, lora_config)\n",
    "model.print_trainable_parameters()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# STEP 5: Train\n",
    "print('Tokenizing...')\n",
    "def tok_fn(ex):\n",
    "    ids = tokenizer(ex['text'], truncation=True, max_length=512).input_ids\n",
    "    return {'input_ids': ids, 'attention_mask': [1]*len(ids)}\n",
    "\n",
    "dataset = Dataset.from_list(formatted).map(tok_fn)\n",
    "dataset = dataset.filter(lambda x: len(x['input_ids']) > 5)\n",
    "print(f'Train set: {len(dataset)}')\n",
    "\n",
    "OUTPUT = '/kaggle/working/sov333-ultra-kaggle'\n",
    "args = TrainingArguments(\n",
    "    output_dir=OUTPUT,\n",
    "    num_train_epochs=1,\n",
    "    per_device_train_batch_size=8,  # T4 has 16GB\n",
    "    gradient_accumulation_steps=4,\n",
    "    learning_rate=3e-4,  # higher LR for rank=32\n",
    "    warmup_steps=50,\n",
    "    logging_steps=50,\n",
    "    save_strategy='epoch',\n",
    "    report_to='none',\n",
    "    fp16=True,  # T4 supports fp16\n",
    "    gradient_checkpointing=True,\n",
    ")\n",
    "trainer = Trainer(model=model, args=args, train_dataset=dataset, data_collator=DataCollatorForLanguageModeling(tokenizer=tokenizer, mlm=False))\n",
    "\n",
    "t0 = time.time()\n",
    "result = trainer.train()\n",
    "duration = time.time() - t0\n",
    "print(f'\\nDONE: {duration/60:.1f} min, train_loss={result.training_loss}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# STEP 6: Save + download\n",
    "import os\n",
    "os.makedirs(OUTPUT, exist_ok=True)\n",
    "model.save_pretrained(OUTPUT)\n",
    "tokenizer.save_pretrained(OUTPUT)\n",
    "\n",
    "# Add README\n",
    "with open(f'{OUTPUT}/README.md', 'w') as f:\n",
    "    f.write(f'# SOV333 ULTRA - Kaggle T4\\nLoss: {result.training_loss}\\nDuration: {duration/60:.1f} min\\nCreated: 2026-07-14\\n')\n",
    "\n",
    "print(f'Saved to {OUTPUT}')\n",
    "print('Files:')\n",
    "for f in os.listdir(OUTPUT):\n",
    "    print(f'  {f}')"
   ]
  }
