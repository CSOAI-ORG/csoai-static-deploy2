{
  "version": "1.0.0",
  "schema": "capability-assertion-v1",
  "assertions": [
    {
      "id": "voice-tts",
      "owem": "voice",
      "mcp": "sovereign-voice-mcp",
      "tool": "tts_emit",
      "input_shape": {"text": "string", "voice": "sovereign|mother|care"},
      "output_shape": {"audio_b64": "string", "duration_ms": "int", "care_score": "float >= 0.95"},
      "care_floor": 0.95,
      "test_prompt": "tts_emit(text='EU AI Act Article 50 live 2 Aug 2026', voice='sovereign')"
    },
    {
      "id": "voice-charter-narrate",
      "owem": "voice",
      "mcp": "sovereign-voice-mcp",
      "tool": "charter_narrate",
      "input_shape": {"article": "string"},
      "output_shape": {"narrative": "string", "sigils": "list[string]"},
      "care_floor": 0.95,
      "test_prompt": "charter_narrate(article='Article 0 — Care before cleverness')"
    },
    {
      "id": "intuition-pattern-detect",
      "owem": "intuition",
      "mcp": "pattern-detection-mcp",
      "tool": "pattern_detect",
      "input_shape": {"signal": "list[float]", "method": "anomaly|cluster|causal|drift"},
      "output_shape": {"anomalies": "list[int]", "score": "float", "explanation": "string"},
      "care_floor": 0.95,
      "test_prompt": "pattern_detect(signal=ts_24h, method='anomaly')"
    },
    {
      "id": "intuition-jepa-predict",
      "owem": "intuition",
      "mcp": "jepa-predictor-mcp",
      "tool": "jepa_predict",
      "input_shape": {"x": "tensor[batch,16]", "horizon": "int"},
      "output_shape": {"y_hat": "tensor[batch,16]", "loss": "float", "curiosity_score": "float"},
      "care_floor": 0.95,
      "test_prompt": "jepa_predict(x=batch_64, horizon=1)"
    },
    {
      "id": "intuition-world-simulate",
      "owem": "intuition",
      "mcp": "world-model-mcp",
      "tool": "world_simulate",
      "input_shape": {"state": "MambaState", "actions": "list[Action]", "horizon": "int"},
      "output_shape": {"rollout": "list[State]", "counterfactuals": "list[State]"},
      "care_floor": 0.95,
      "test_prompt": "world_simulate(state=s0, actions=[a1,a2], horizon=10)"
    },
    {
      "id": "compliance-dpia",
      "owem": "compliance",
      "mcp": "dpia-mcp",
      "tool": "dpia_start",
      "input_shape": {"processing_description": "string", "data_categories": "list[string]"},
      "output_shape": {"risk_level": "high|medium|low", "mitigations": "list[string]", "sigils": "list[string]"},
      "care_floor": 0.95,
      "test_prompt": "dpia_start(processing='AI triage system', data_categories=['health','location'])"
    },
    {
      "id": "defense-threat-intel",
      "owem": "defense",
      "mcp": "threat-intel-mcp",
      "tool": "ioc_enrich",
      "input_shape": {"ioc": "string", "type": "ipv4|domain|hash|email"},
      "output_shape": {"threat_actors": "list[string]", "ttps": "list[string]", "confidence": "float"},
      "care_floor": 0.95,
      "test_prompt": "ioc_enrich(ioc='192.0.2.1', type='ipv4')"
    },
    {
      "id": "general-capability-assert",
      "owem": "general",
      "mcp": "capability-test-mcp",
      "tool": "capability_assert",
      "input_shape": {"capability_id": "string"},
      "output_shape": {"pass": "bool", "evidence": "string", "sigil": "string"},
      "care_floor": 0.95,
      "test_prompt": "capability_assert(capability_id='voice-tts')"
    }
  ]
}
