{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CSOAI Unified Four-Axis Benchmark Definition v1",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "benchmark_id",
    "benchmark_version",
    "axes",
    "case_library",
    "matrix",
    "partition_policy",
    "entrant_policy",
    "outcome_policy",
    "inference_policy",
    "integrity_policy",
    "compatibility"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "csoai.unified-four-axis.definition"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "benchmark_id": {
      "type": "string",
      "const": "csoai-unified-four-axis"
    },
    "benchmark_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string"
    },
    "axes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "axis_id",
          "label",
          "canonical_sources",
          "metrics",
          "thresholds"
        ],
        "additionalProperties": false,
        "properties": {
          "axis_id": {
            "type": "string",
            "enum": [
              "governance",
              "safety",
              "provenance",
              "continuity"
            ]
          },
          "label": {
            "type": "string"
          },
          "canonical_sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "module",
                    "symbol",
                    "lens"
                  ]
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "thresholds": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minimum_coverage": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minimum_conditional_pass_rate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "maximum_indeterminate_rate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minimum_paired_delta": {
                "type": "number"
              },
              "require_ci_lower_bound_above_zero": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "case_library": {
      "type": "array",
      "minItems": 56,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "axis_id",
          "control_class",
          "expected_disposition",
          "input_ref",
          "assertion_refs",
          "timeout_ms",
          "enabled"
        ],
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "axis_id": {
            "type": "string",
            "enum": [
              "governance",
              "safety",
              "provenance",
              "continuity"
            ]
          },
          "control_class": {
            "type": "string",
            "enum": [
              "positive",
              "benign_near",
              "negative",
              "malformed",
              "unavailable",
              "timeout_incomplete",
              "tamper_signature"
            ]
          },
          "expected_disposition": {
            "type": "string",
            "enum": [
              "accept",
              "reject",
              "indeterminate"
            ]
          },
          "input_ref": {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "canonical_fixture",
                  "synthetic_fixture",
                  "generator_ref"
                ]
              },
              "value": {
                "type": "string"
              }
            }
          },
          "assertion_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "timeout_ms": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "enabled": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "matrix": {
      "type": "object",
      "required": [
        "required_control_classes",
        "cells",
        "minimum_cases_per_cell"
      ],
      "additionalProperties": false,
      "properties": {
        "required_control_classes": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "string",
            "enum": [
              "positive",
              "benign_near",
              "negative",
              "malformed",
              "unavailable",
              "timeout_incomplete",
              "tamper_signature"
            ]
          }
        },
        "cells": {
          "type": "array",
          "minItems": 28,
          "items": {
            "type": "object",
            "required": [
              "axis_id",
              "control_class",
              "case_ids"
            ],
            "additionalProperties": false,
            "properties": {
              "axis_id": {
                "type": "string",
                "enum": [
                  "governance",
                  "safety",
                  "provenance",
                  "continuity"
                ]
              },
              "control_class": {
                "type": "string",
                "enum": [
                  "positive",
                  "benign_near",
                  "negative",
                  "malformed",
                  "unavailable",
                  "timeout_incomplete",
                  "tamper_signature"
                ]
              },
              "case_ids": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "minimum_cases_per_cell": {
          "type": "integer",
          "const": 2
        }
      }
    },
    "partition_policy": {
      "type": "object",
      "required": [
        "method",
        "owner",
        "assignment_unit",
        "partitions"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "const": "canonical_flywheel_split"
        },
        "owner": {
          "type": "string",
          "const": "flywheel.py"
        },
        "assignment_unit": {
          "type": "string",
          "const": "case_id"
        },
        "partitions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "enum": [
              "practice",
              "held_out"
            ]
          }
        },
        "held_out_visibility": {
          "type": "string",
          "const": "concealed_until_execution"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string"
            }
          }
        }
      }
    },
    "entrant_policy": {
      "type": "object",
      "required": [
        "roles",
        "required_cardinality",
        "pairing_keys",
        "control_eligible_for_claims"
      ],
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "enum": [
              "baseline",
              "challenger",
              "control"
            ]
          }
        },
        "required_cardinality": {
          "type": "object",
          "required": [
            "baseline",
            "challenger",
            "control"
          ],
          "additionalProperties": false,
          "properties": {
            "baseline": {
              "type": "integer",
              "const": 1
            },
            "challenger": {
              "type": "integer",
              "const": 1
            },
            "control": {
              "type": "integer",
              "const": 1
            }
          }
        },
        "pairing_keys": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "enum": [
              "case_id",
              "partition"
            ]
          }
        },
        "control_eligible_for_claims": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "outcome_policy": {
      "type": "object",
      "required": [
        "outcomes",
        "indeterminate_reasons",
        "denominator_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "outcomes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "indeterminate"
            ]
          }
        },
        "indeterminate_reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "unavailable",
              "timeout",
              "incomplete",
              "malformed_result",
              "adapter_error",
              "evidence_missing",
              "integrity_failure"
            ]
          }
        },
        "denominator_policy": {
          "type": "object",
          "required": [
            "conditional_rate",
            "coverage",
            "indeterminate_rate"
          ],
          "additionalProperties": false,
          "properties": {
            "conditional_rate": {
              "type": "string",
              "const": "pass / (pass + fail)"
            },
            "coverage": {
              "type": "string",
              "const": "(pass + fail) / total"
            },
            "indeterminate_rate": {
              "type": "string",
              "const": "indeterminate / total"
            }
          }
        }
      }
    },
    "inference_policy": {
      "type": "object",
      "required": [
        "comparison",
        "primary_partition",
        "confidence_level",
        "interval_method",
        "minimum_paired_determinate_cases",
        "composite_score"
      ],
      "additionalProperties": false,
      "properties": {
        "comparison": {
          "type": "string",
          "const": "paired_baseline_challenger"
        },
        "primary_partition": {
          "type": "string",
          "const": "held_out"
        },
        "confidence_level": {
          "type": "number",
          "const": 0.95
        },
        "interval_method": {
          "type": "string",
          "const": "paired_case_bootstrap"
        },
        "minimum_paired_determinate_cases": {
          "type": "integer",
          "const": 20
        },
        "minimum_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "multiple_comparison_policy": {
          "type": "string",
          "const": "four_independent_axis_claims"
        },
        "composite_score": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "integrity_policy": {
      "type": "object",
      "required": [
        "canonicalization",
        "hash_algorithm"
      ],
      "additionalProperties": false,
      "properties": {
        "canonicalization": {
          "type": "string",
          "enum": [
            "rfc8785_jcs",
            "recursive_sorted_json"
          ]
        },
        "hash_algorithm": {
          "type": "string",
          "const": "sha-256"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "required": [
        "legacy_export",
        "minimum_dashboard_reader"
      ],
      "additionalProperties": false,
      "properties": {
        "legacy_export": {
          "type": "object",
          "required": [
            "supported",
            "format",
            "deprecated_after"
          ],
          "additionalProperties": false,
          "properties": {
            "supported": {
              "type": "boolean",
              "const": true
            },
            "format": {
              "type": "string",
              "const": "years-to-days-e2e-v1"
            },
            "deprecated_after": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "minimum_dashboard_reader": {
          "type": "string",
          "const": "1.0.0"
        }
      }
    }
  }
}