{
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "**/*.{html,json,xml}",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.{html,json,xml}",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.{html,json,xml}",
      "use": "@vercel/static"
    },
    {
