<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        com.csoai.overnight-e2e
        Overnight E2E pipeline for the CSOAI Sovereign Estate.
        Runs nightly at 02:15 BST (lower-noise window after the 02:00 daily flywheel cron).

        Install:
            cp com.csoai.overnight-e2e.plist ~/Library/LaunchAgents/
            launchctl load ~/Library/LaunchAgents/com.csoai.overnight-e2e.plist
        Uninstall:
            launchctl unload ~/Library/LaunchAgents/com.csoai.overnight-e2e.plist
            rm ~/Library/LaunchAgents/com.csoai.overnight-e2e.plist

        Manual run:
            bash ~/clawd/csoai-static-deploy2/overnight_e2e.sh

        Inspect:
            cat ~/clawd/csoai-static-deploy2/logs/overnight_e2e_*.log
            cat ~/clawd/csoai-static-deploy2/benchmark-results/overnight_e2e_*.json
    -->
    <key>Label</key>
    <string>com.csoai.overnight-e2e</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/nicholas/clawd/csoai-static-deploy2/overnight_e2e.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>2</integer>
            <key>Minute</key>
            <integer>15</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/nicholas/clawd/csoai-static-deploy2/logs/overnight_e2e.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/nicholas/clawd/csoai-static-deploy2/logs/overnight_e2e.err.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/nicholas/clawd/csoai-static-deploy2</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>OLLAMA_URL</key>
        <string>http://localhost:11434</string>
        <key>FLYWHEEL_DATA_DIR</key>
        <string>/Users/nicholas/clawd/csoai-static-deploy2/benchmark-results</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>

    <!--
        Throttle interval: if a previous run is still in flight, wait 30 minutes.
        Prevents overlapping runs from cron + manual triggers.
    -->
    <key>ThrottleInterval</key>
    <integer>1800</integer>
</dict>
</plist>