{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CSOAI Unified Four-Axis Benchmark Run v1",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "definition",
    "entrants",
    "partition_resolution",
    "environment",
    "executions",
    "axis_results",
    "claims",
    "artifacts",
    "integrity",
    "run_status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "csoai.unified-four-axis.run"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "object",
      "required": [
        "benchmark_id",
        "benchmark_version",
        "schema_version",
        "definition_ref",
        "canonicalization",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "benchmark_id": {
          "type": "string",
          "const": "csoai-unified-four-axis"
        },
        "benchmark_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "definition_ref": {
          "type": "string",
          "minLength": 1
        },
        "canonicalization": {
          "type": "string",
          "enum": [
            "rfc8785_jcs",
            "recursive_sorted_json"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "entrants": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "entrant_id",
          "role",
          "implementation",
          "config_sha256",
          "secret_fields_redacted"
        ],
        "additionalProperties": false,
        "properties": {
          "entrant_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "baseline",
              "challenger",
              "control"
            ]
          },
          "display_name": {
            "type": "string"
          },
          "implementation": {
            "type": "object",
            "required": [
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "http",
                  "subprocess",
                  "fixture"
                ]
              },
              "version": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              }
            }
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "secret_fields_redacted": {
            "type": "boolean",
            "const": true
          }
        }
      }
    },
    "partition_resolution": {
      "type": "object",
      "required": [
        "method",
        "owner",
        "invocation",
        "assignments",
        "assignments_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "const": "canonical_flywheel_split"
        },
        "owner": {
          "type": "string",
          "const": "flywheel.py"
        },
        "invocation": {
          "type": "object",
          "required": [
            "adapter_version",
            "canonical_repo_revision",
            "parameters_sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "adapter_version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "canonical_repo_revision": {
              "type": "string"
            },
            "parameters_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "case_id",
              "partition"
            ],
            "additionalProperties": false,
            "properties": {
              "case_id": {
                "type": "string",
                "minLength": 1
              },
              "partition": {
                "type": "string",
                "enum": [
                  "practice",
                  "held_out"
                ]
              }
            }
          }
        },
        "assignments_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "started_at",
        "completed_at",
        "host_platform",
        "python_version",
        "canonical_repo_revision",
        "runner_version",
        "stats_version"
      ],
      "additionalProperties": false,
      "properties": {
        "started_at": {
          "type": "string"
        },
        "completed_at": {
          "type": "string"
        },
        "host_platform": {
          "type": "string"
        },
        "python_version": {
          "type": "string"
        },
        "canonical_repo_revision": {
          "type": "string"
        },
        "dashboard_repo_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "runner_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "stats_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "locale": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "bootstrap_seed": {
          "type": "string"
        }
      }
    },
    "executions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "execution_id",
          "entrant_id",
          "entrant_role",
          "case_id",
          "axis_id",
          "control_class",
          "partition",
          "expected_disposition",
          "outcome",
          "indeterminate_reason",
          "metric_values",
          "evidence_refs",
          "input_sha256",
          "output_sha256",
          "adapter"
        ],
        "additionalProperties": false,
        "properties": {
          "execution_id": {
            "type": "string",
            "minLength": 1
          },
          "entrant_id": {
            "type": "string",
            "minLength": 1
          },
          "entrant_role": {
            "type": "string",
            "enum": [
              "baseline",
              "challenger",
              "control"
            ]
          },
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "axis_id": {
            "type": "string",
            "enum": [
              "governance",
              "safety",
              "provenance",
              "continuity"
            ]
          },
          "control_class": {
            "type": "string",
            "enum": [
              "positive",
              "benign_near",
              "negative",
              "malformed",
              "unavailable",
              "timeout_incomplete",
              "tamper_signature"
            ]
          },
          "partition": {
            "type": "string",
            "enum": [
              "practice",
              "held_out"
            ]
          },
          "expected_disposition": {
            "type": "string",
            "enum": [
              "accept",
              "reject",
              "indeterminate"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "indeterminate"
            ]
          },
          "indeterminate_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "unavailable",
              "timeout",
              "incomplete",
              "malformed_result",
              "adapter_error",
              "evidence_missing",
              "integrity_failure"
            ]
          },
          "metric_values": {
            "type": "object",
            "additionalProperties": true
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "output_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "adapter": {
            "type": "object",
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              }
            }
          }
        }
      }
    },
    "axis_results": {
      "type": "array",
      "minItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "axis_id",
              "entrant_id",
              "role",
              "partition",
              "counts",
              "metrics"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "const": "entrant_axis_summary"
              },
              "axis_id": {
                "type": "string",
                "enum": [
                  "governance",
                  "safety",
                  "provenance",
                  "continuity"
                ]
              },
              "entrant_id": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "baseline",
                  "challenger",
                  "control"
                ]
              },
              "partition": {
                "type": "string",
                "enum": [
                  "practice",
                  "held_out"
                ]
              },
              "counts": {
                "type": "object",
                "required": [
                  "total",
                  "pass",
                  "fail",
                  "indeterminate"
                ],
                "additionalProperties": false,
                "properties": {
                  "total": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "pass": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "fail": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "indeterminate": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "metrics": {
                "type": "object",
                "required": [
                  "coverage",
                  "conditional_pass_rate",
                  "indeterminate_rate"
                ],
                "additionalProperties": false,
                "properties": {
                  "coverage": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "conditional_pass_rate": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "indeterminate_rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "axis_id",
              "partition",
              "baseline_entrant_id",
              "challenger_entrant_id",
              "paired_determinate_n",
              "excluded_pairs",
              "delta",
              "coverage_delta",
              "control_eligible_for_claims"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "const": "paired_axis_comparison"
              },
              "axis_id": {
                "type": "string",
                "enum": [
                  "governance",
                  "safety",
                  "provenance",
                  "continuity"
                ]
              },
              "partition": {
                "type": "string",
                "const": "held_out"
              },
              "baseline_entrant_id": {
                "type": "string"
              },
              "challenger_entrant_id": {
                "type": "string"
              },
              "paired_determinate_n": {
                "type": "integer",
                "minimum": 0
              },
              "excluded_pairs": {
                "type": "object",
                "required": [
                  "baseline_indeterminate",
                  "challenger_indeterminate",
                  "both_indeterminate",
                  "missing_execution"
                ],
                "additionalProperties": false,
                "properties": {
                  "baseline_indeterminate": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "challenger_indeterminate": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "both_indeterminate": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "missing_execution": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "delta": {
                "type": "object",
                "required": [
                  "metric",
                  "estimate",
                  "confidence_interval"
                ],
                "additionalProperties": false,
                "properties": {
                  "metric": {
                    "type": "string",
                    "const": "conditional_pass_rate"
                  },
                  "estimate": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "confidence_interval": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "required": [
                      "level",
                      "lower",
                      "upper",
                      "method"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "level": {
                        "type": "number",
                        "const": 0.95
                      },
                      "lower": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "upper": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "method": {
                        "type": "string",
                        "const": "paired_case_bootstrap"
                      }
                    }
                  }
                }
              },
              "coverage_delta": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "control_eligible_for_claims": {
                "type": "boolean",
                "const": false
              }
            }
          }
        ]
      }
    },
    "claims": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "axis_id",
          "outcome",
          "eligible",
          "reasons"
        ],
        "additionalProperties": false,
        "properties": {
          "axis_id": {
            "type": "string",
            "enum": [
              "governance",
              "safety",
              "provenance",
              "continuity"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "challenger_better",
              "no_material_difference",
              "challenger_worse",
              "no_claim"
            ]
          },
          "eligible": {
            "type": "boolean"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "media_type",
          "uri",
          "sha256",
          "size_bytes",
          "producer",
          "contains_sensitive_data"
        ],
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "producer": {
            "type": "string"
          },
          "contains_sensitive_data": {
            "type": "boolean",
            "const": false
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "manifest_canonicalization",
        "manifest_sha256",
        "definition_verified",
        "evidence_hashes_verified"
      ],
      "additionalProperties": false,
      "properties": {
        "manifest_canonicalization": {
          "type": "string",
          "enum": [
            "rfc8785_jcs",
            "recursive_sorted_json"
          ]
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "definition_verified": {
          "type": "boolean"
        },
        "evidence_hashes_verified": {
          "type": "boolean"
        },
        "signature": {
          "type": "object",
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "verified",
                "absent",
                "invalid"
              ]
            },
            "algorithm": {
              "type": [
                "string",
                "null"
              ]
            },
            "key_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "signature_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "run_status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete",
        "invalid"
      ]
    }
  }
}