    "pairing_keys": ["case_id", "partition"],
    "control_eligible_for_claims": false
  },
  "outcome_policy": {
    "outcomes": ["pass", "fail", "indeterminate"],
    "indeterminate_reasons": [
      "unavailable",
      "timeout",
      "incomplete",
      "malformed_result",
      "adapter_error",
      "evidence_missing",
      "integrity_failure"
    ],
    "denominator_policy": {
      "conditional_rate": "pass / (pass + fail)",
      "coverage": "(pass + fail) / total",
      "indeterminate_rate": "indeterminate / total"
    }
  },
  "inference_policy": {
    "comparison": "paired_baseline_challenger",
    "primary_partition": "held_out",
    "confidence_level": 0.95,
    "interval_method": "paired_case_bootstrap",
    "minimum_paired_determinate_cases": 20,
    "minimum_coverage": 0.9,
    "multiple_comparison_policy": "four_independent_axis_claims",
    "composite_score": false
  },
  "integrity_policy": {
    "canonicalization": "recursive_sorted_json",
    "hash_algorithm": "sha-256"
  },
  "compatibility": {
    "legacy_export": {
      "supported": true,
      "format": "years-to-days-e2e-v1",
      "deprecated_after": null
    },
    "minimum_dashboard_reader": "1.0.0"
  }
}